NEXT_PUBLIC_BASE_PATH=/aione-instagram
PORTAL_PUBLIC_ORIGIN=https://tools.aione.co.jp
PORTAL_SHEETS_TRANSPORT=api
PORTAL_SOURCE_CONFIG_FILE=REPLACE_WITH_ABSOLUTE_PRIVATE_CONFIG_PATH
PORTAL_STATE_FILE=REPLACE_WITH_ABSOLUTE_PRIVATE_PERSISTENT_STATE_PATH
PORTAL_ADMIN_PASSWORD_HASH=REPLACE_WITH_EXISTING_BCRYPT_HASH
PORTAL_NATIVE_START_MONTH=2026-11
PORTAL_SHEET_CACHE_MS=30000
# GOOGLE_APPLICATION_CREDENTIALS=REPLACE_WITH_PRIVATE_CREDENTIAL_PATH
NEXT_TELEMETRY_DISABLED=1
# LINE secrets and private appointment-source configuration; never commit real values.
PORTAL_NOTIFICATION_CONFIG_FILE=REPLACE_WITH_ABSOLUTE_PRIVATE_NOTIFICATION_CONFIG_PATH
PORTAL_NOTIFICATION_STATE_FILE=REPLACE_WITH_ABSOLUTE_PERSISTENT_LEDGER_PATH
PORTAL_SCHEDULES_FILE=REPLACE_WITH_ABSOLUTE_REVIEWED_SCHEDULE_PATH
PORTAL_SCHEDULER_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PORTAL_TOP5_DOWNLOAD_KEY=REPLACE_WITH_RANDOM_PRIVATE_DOWNLOAD_KEY
# Set these only when the deployment operator approves the production cutover.
PORTAL_JOBS_ENABLED=false
PORTAL_JOB_OWNER=gas
PORTAL_JOBS_NOT_BEFORE=REPLACE_WITH_EXPLICIT_ISO_CUTOVER_TIME
PORTAL_MONTHLY_OUTPUT_CONFIG_FILE=REPLACE_WITH_ABSOLUTE_PRIVATE_OUTPUT_CONFIG_PATH
PORTAL_MONTHLY_OUTPUT_STATE_FILE=REPLACE_WITH_ABSOLUTE_PERSISTENT_OUTPUT_STATE_PATH
